# ── GCP (via ADC — never paste key contents here) ─────────────────────────
GCP_PROJECT_ID=YOUR_PROJECT_ID
GCP_REGION=REGION
# GOOGLE_APPLICATION_CREDENTIALS is set automatically by google-github-actions/auth
# in CI. Locally: run `gcloud auth application-default login`.

# ── GitHub ─────────────────────────────────────────────────────────────────
# For local runs: set to a PAT with contents:write + pull-requests:write.
# In CI this is set automatically from the GH Actions context.
GITHUB_TOKEN=ghp_YOUR_PAT_HERE
GITHUB_REPOSITORY=owner/locus-demo-app
# GITHUB_RUN_ID and GITHUB_PR_NUMBER are set automatically in CI.
# For local runs, leave unset (defaults to "local" and undefined respectively).

# ── Locus Workload Identity Federation (CI only, set as GitHub Secrets) ───
# WIF_PROVIDER=projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
# WIF_SERVICE_ACCOUNT=locus-ci@locus-dev-506512.iam.gserviceaccount.com

# ── Locus Pipeline Configuration ───────────────────────────────────────────
CLASSIFIER_MODEL=gemini-3.1-flash-lite
RESOLVER_MODEL=gemini-3.1-pro
HEAL_BUDGET=3
FIRESTORE_DATABASE_ID=(default)
POM_DIR=tests/pages
POM_GLOB=**/*.page.ts
